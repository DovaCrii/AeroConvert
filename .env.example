# AeroConvert — copia este archivo a `.env` y ajusta lo que corresponda.
# Ningun valor real de produccion vive en el repositorio.

# --- Django ---------------------------------------------------------------
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
DEBUG=True
DB_PATH=db.sqlite3
TIME_ZONE=America/Santiago

# --- Modo -----------------------------------------------------------------
# `taller`: los archivos NO se copian ni se suben: se leen de donde estan, y
#           `AEROCONVERT_RAICES_PERMITIDAS` decide de donde. Sin tope de tamano.
#           **Es tambien el modo de la VM compartida**, con las raices apuntando
#           a la carpeta de red. Ver el bloque del final.
# `nube`  : el modo de las subidas. **Todavia no sirve**: la subida de archivos
#           no esta escrita, asi que la aplicacion arrancaria y no convertiria
#           nada. `manage.py check` se niega, a proposito.
AEROCONVERT_MODO=taller

# Solo en modo `taller`, y es OBLIGATORIA. La ruta de origen la teclea una
# persona, asi que sin esta lista la aplicacion seria un primitivo de lectura
# del disco entero. Varias rutas se separan con `;`.
AEROCONVERT_RAICES_PERMITIDAS=D:\

# Solo en modo `nube`.
AEROCONVERT_TOPE_MB=2048

# --- Retencion y disco ----------------------------------------------------
# GDAL necesita un archivo real con acceso aleatorio: algo toca disco siempre. Lo que se
# elige aqui es cuanto sobrevive y cuanto se deja gastar.
#
# `efimera`    : la salida se borra en cuanto se descarga. Nada se acumula.
# `temporal`   : se guarda AEROCONVERT_RETENCION_HORAS y se barre.
# `permanente` : no se barre nunca.
# Vacio = `permanente` en taller (la salida vive junto al original) y `efimera` en nube.
AEROCONVERT_RETENCION=

# Donde viven las salidas mientras esperan a ser descargadas. Vacio = <repo>/trabajo.
# Conviene ponerla en un volumen que no sea el del sistema.
AEROCONVERT_CARPETA_DE_TRABAJO=

# Cuanto sobrevive una salida efimera que nadie llego a descargar.
AEROCONVERT_EFIMERA_MINUTOS=30
# Cuanto sobrevive con politica `temporal`.
AEROCONVERT_RETENCION_HORAS=24

# LO QUE DE VERDAD PROTEGE EL DISCO. Un trabajo que no cabe espera en la cola en vez de
# llenar el volumen. Se pide el doble del tamano de entrada, porque durante un instante
# conviven el parcial y el definitivo.
AEROCONVERT_PRESUPUESTO_GB=20

# --- Motores externos -----------------------------------------------------
# GDAL. Se antepone al PATH del PROCESO HIJO, nunca al del servidor.
# En esta maquina QGIS ya lo trae: C:\Program Files\QGIS 4.0.2\bin
AEROCONVERT_GDAL_BIN=

# PDAL, para nubes de puntos (fase 2). Suele venir en la misma carpeta que GDAL.
AEROCONVERT_PDAL_BIN=

# ECW. Escribir ECW exige una clave OEM de Hexagon; sin ella el destino ECW
# aparece apagado con su motivo y se sugiere COG o JP2. Ver `docs/MOTORES.md`.
AEROCONVERT_ECW_ENCODE_KEY=
AEROCONVERT_ECW_ENCODE_COMPANY=
# Alternativa: un ejecutable externo que comprima a ECW.
AEROCONVERT_ECW_BIN=

# ODA File Converter, para DWG y DGN (fase 3). Gratuito, con su propia
# licencia; no se distribuye con AeroConvert.
AEROCONVERT_ODA_CONVERTER=

# --- Ejecucion ------------------------------------------------------------
# Cuantas conversiones a la vez. Por omision 1: GDAL ya usa todos los nucleos,
# y dos conversiones compitiendo por el mismo disco es mas lento, no mas rapido.
AEROCONVERT_TRABAJOS_SIMULTANEOS=1
# Presupuesto de tiempo por gigabyte de entrada.
AEROCONVERT_SEGUNDOS_POR_GB=900
# Sin un tic de progreso ni un byte de stderr en este tiempo, el trabajo se da
# por atascado. Es el detector util; el presupuesto total es solo el respaldo.
AEROCONVERT_SILENCIO_MAXIMO_S=600

# El hilo del despachador dentro de este proceso. En la estacion de trabajo, si:
# `run.ps1` arranca uno solo. **En la VM va a 0 en el servicio web y a 1 solo en
# la unidad del obrero**; el motivo esta en config/settings/base.py.
AEROCONVERT_DESPACHADOR=1


# ===========================================================================
# LA VM COMPARTIDA (Ubuntu 26.04, publicada con Tailscale Funnel)
# ===========================================================================
# Para la estacion de trabajo deja este bloque comentado y usa el de arriba.
#
# El modulo de ajustes es `config.settings.prod` **con AEROCONVERT_MODO=taller**.
# Taller no significa «una sola persona»: significa que se puede leer del disco,
# que es como llega una ortofoto de 20 GB. Las subidas por navegador funcionan
# igual en los dos modos. Ver despliegue/SERVIDOR.md.

# --- Obligatorias. Sin estas, 400 en TODO ----------------------------------
# El nombre por el que se llega, separado por comas. **Sin el puerto**: Django
# compara esto contra el nombre a secas. Sin ello responde 400 a cualquier
# peticion y, con DEBUG=False, no dice por que.
# ALLOWED_HOSTS=p340.tailccd107.ts.net

# **Con esquema y CON el puerto**, que es lo que exige Django: aqui se compara
# el origen entero. Puesto al reves, la pantalla de entrada acepta la contrasena
# y luego devuelve 403 al enviar el formulario.
# CSRF_TRUSTED_ORIGINS=https://p340.tailccd107.ts.net:8443

# Larga y aleatoria; `check --deploy` falla por debajo de 50 caracteres.
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY=
# DEBUG=False

# --- Donde vive cada cosa --------------------------------------------------
# FUERA del arbol de codigo, a proposito: asi un `git pull` no puede tocar la
# base y el respaldo tiene un sitio estable.
# DB_PATH=/var/lib/aeroconvert/db.sqlite3
# AEROCONVERT_CARPETA_DE_TRABAJO=/var/lib/aeroconvert/trabajo
# AEROCONVERT_MEDIA=/var/lib/aeroconvert/entradas

# La carpeta compartida por Samba, montada en la VM. **Es la unica ruta del
# disco que la aplicacion puede leer.** Nunca pongas `/` ni `/mnt`: en una
# maquina compartida, `manage.py check` lo rechaza.
# AEROCONVERT_MODO=taller
# AEROCONVERT_RAICES_PERMITIDAS=/mnt/entregas

# --- Ejecucion en la VM ----------------------------------------------------
# 0 en el servicio web, 1 solo en aeroconvert-obrero.service.
# AEROCONVERT_DESPACHADOR=0

# --- Motores en Ubuntu -----------------------------------------------------
#   apt install gdal-bin
# NUNCA `pip install gdal`: la rueda no trae los controladores que se sondean.
# AEROCONVERT_GDAL_BIN=/usr/bin
#
# **PDAL no esta empaquetado en Ubuntu 26.04.** Dejalo vacio y las nubes de
# puntos salen apagadas con su motivo escrito, que es lo correcto. Si algun dia
# se instala de conda-forge, apunta aqui a su carpeta de binarios.
# AEROCONVERT_PDAL_BIN=
#
# Office a PDF y PDF a Word **no existen en Linux**: hablan con Office por COM.
# Salen apagadas con su motivo, que es lo correcto.
