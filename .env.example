# AeroConvert — copia este archivo a `.env` y ajusta lo que corresponda.
# Ningun valor real de produccion vive en el repositorio.

# --- Django ---------------------------------------------------------------
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
DEBUG=True
DB_PATH=db.sqlite3
TIME_ZONE=America/Santiago

# --- Modo -----------------------------------------------------------------
# `taller`: corre en la estacion de trabajo. Los archivos NO se copian ni se
#           suben: se leen de donde estan. Sin tope de tamano.
# `nube`  : corre en un servidor. Los archivos se suben, con tope.
AEROCONVERT_MODO=taller

# Solo en modo `taller`, y es OBLIGATORIA. La ruta de origen la teclea una
# persona, asi que sin esta lista la aplicacion seria un primitivo de lectura
# del disco entero. Varias rutas se separan con `;`.
AEROCONVERT_RAICES_PERMITIDAS=D:\

# Solo en modo `nube`.
AEROCONVERT_TOPE_MB=2048

# --- Retencion y disco ----------------------------------------------------
# GDAL necesita un archivo real con acceso aleatorio: algo toca disco siempre. Lo que se
# elige aqui es cuanto sobrevive y cuanto se deja gastar.
#
# `efimera`    : la salida se borra en cuanto se descarga. Nada se acumula.
# `temporal`   : se guarda AEROCONVERT_RETENCION_HORAS y se barre.
# `permanente` : no se barre nunca.
# Vacio = `permanente` en taller (la salida vive junto al original) y `efimera` en nube.
AEROCONVERT_RETENCION=

# Donde viven las salidas mientras esperan a ser descargadas. Vacio = <repo>/trabajo.
# Conviene ponerla en un volumen que no sea el del sistema.
AEROCONVERT_CARPETA_DE_TRABAJO=

# Cuanto sobrevive una salida efimera que nadie llego a descargar.
AEROCONVERT_EFIMERA_MINUTOS=30
# Cuanto sobrevive con politica `temporal`.
AEROCONVERT_RETENCION_HORAS=24

# LO QUE DE VERDAD PROTEGE EL DISCO. Un trabajo que no cabe espera en la cola en vez de
# llenar el volumen. Se pide el doble del tamano de entrada, porque durante un instante
# conviven el parcial y el definitivo.
AEROCONVERT_PRESUPUESTO_GB=20

# --- Motores externos -----------------------------------------------------
# GDAL. Se antepone al PATH del PROCESO HIJO, nunca al del servidor.
# En esta maquina QGIS ya lo trae: C:\Program Files\QGIS 4.0.2\bin
AEROCONVERT_GDAL_BIN=

# PDAL, para nubes de puntos (fase 2). Suele venir en la misma carpeta que GDAL.
AEROCONVERT_PDAL_BIN=

# ECW. Escribir ECW exige una clave OEM de Hexagon; sin ella el destino ECW
# aparece apagado con su motivo y se sugiere COG o JP2. Ver `docs/MOTORES.md`.
AEROCONVERT_ECW_ENCODE_KEY=
AEROCONVERT_ECW_ENCODE_COMPANY=
# Alternativa: un ejecutable externo que comprima a ECW.
AEROCONVERT_ECW_BIN=

# ODA File Converter, para DWG y DGN (fase 3). Gratuito, con su propia
# licencia; no se distribuye con AeroConvert.
AEROCONVERT_ODA_CONVERTER=

# --- Ejecucion ------------------------------------------------------------
# Cuantas conversiones a la vez. Por omision 1: GDAL ya usa todos los nucleos,
# y dos conversiones compitiendo por el mismo disco es mas lento, no mas rapido.
AEROCONVERT_TRABAJOS_SIMULTANEOS=1
# Presupuesto de tiempo por gigabyte de entrada.
AEROCONVERT_SEGUNDOS_POR_GB=900
# Sin un tic de progreso ni un byte de stderr en este tiempo, el trabajo se da
# por atascado. Es el detector util; el presupuesto total es solo el respaldo.
AEROCONVERT_SILENCIO_MAXIMO_S=600
